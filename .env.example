# Settings for `make` (local/README.md). Copy to .env (`make env`), edit.
# KEY=value, shell syntax; a variable set on the command line or in the
# environment wins over this file. Secrets are never values here: only paths
# to files holding them (keep those 0600).

# === where things live =========================================================
# This repo (or your site fork): overlays, Helm values, catalog, org.
RKE2_DEPLOY_REPO=.
# Local Run:ai/RKE2 artifact repository: images (OCI layout), charts, lock,
# RPMs, overlays, source snapshot. ~30 GB for the full lab registry.
RUNAI_REPO=./_runai-repo

# === source: the remote system everything is pulled from =========================
REMOTE_SSH=root@ww1
REMOTE_SSH_OPTS=
# registry as the remote host sees it, and where its account/work dir live
REMOTE_REGISTRY=10.10.172.1:5000
REMOTE_REG_DIR=/etc/rke2-registry
REMOTE_RUNAI_WORK=/var/lib/runai-deploy
# yes: SSH tunnel to the registry (needs native skopeo); no: direct, CA-verified
REMOTE_TUNNEL=yes
REMOTE_TUNNEL_PORT=15000
# extended regexes on repository paths; charts/* are fetched as tarballs
FETCH_INCLUDE=
FETCH_EXCLUDE=^charts/
# RKE2 RPMs (same version as the remote server) for the GPU nodes' image
FETCH_RKE2_RPMS=yes
TARGET_ARCH=amd64

# === target: the existing RKE2 GPU cluster =======================================
KUBECONFIG=~/.kube/gpu-cluster.yaml
# Registry the GPU nodes pull from. Images keep their upstream paths under
# TARGET_REGISTRY[/TARGET_REGISTRY_PREFIX] (registries.yaml mirrors "*" there).
TARGET_REGISTRY=registry.example.com
TARGET_REGISTRY_PREFIX=
TARGET_REGISTRY_USER=runai-push
TARGET_REGISTRY_PASSWORD_FILE=~/.secrets/registry-push-password
# CA of the registry certificate (empty = system trust)
TARGET_REGISTRY_CA=
TARGET_REGISTRY_TLS_VERIFY=true
# What Run:ai workloads reference and pull with (pull-only robot account).
# Must serve the same content as TARGET_REGISTRY (same host, or a read-only
# view of the same storage).
TARGET_WORKLOAD_REGISTRY=registry.example.com
TARGET_WORKLOAD_PULL_USER=runai-pull
TARGET_WORKLOAD_PULL_PASSWORD_FILE=~/.secrets/registry-pull-password

# === Run:ai ======================================================================
RUNAI_DOMAIN=runai.example.com
# certificate for RUNAI_DOMAIN (+ *.RUNAI_DOMAIN when RUNAI_SUBDOMAINS=yes)
RUNAI_TLS_CERT=~/.secrets/runai/fullchain.crt
RUNAI_TLS_KEY=~/.secrets/runai/tls.key
RUNAI_CA_CERT=~/.secrets/runai/ca.crt
# connect here instead of DNS for API calls (empty = DNS)
RUNAI_RESOLVE_IP=
RUNAI_ADMIN_USER=admin@example.com
# generated on first deploy if the file does not exist
RUNAI_ADMIN_PASSWORD_FILE=./_runai-repo/secrets/runai-admin-password
RUNAI_CLUSTER_NAME=gpu
RUNAI_INGRESS_CLASS=nginx
# prod = values/<chart>.yaml only; lab adds values/<chart>-lab.yaml (small requests)
RUNAI_SIZING=prod
RUNAI_SUBDOMAINS=yes
# remove environments whose image the workload registry does not serve
RUNAI_PRUNE_ENVIRONMENTS=yes
# extra values files: <dir>/<chart>.yaml is layered last (control-plane.yaml, ...)
SITE_VALUES_DIR=

# === components ==================================================================
# auto = only if the Prometheus Operator CRDs are missing | yes | no
INSTALL_PROMETHEUS=auto
# skip (GPUs already managed) | install (NVIDIA GPU Operator) | fake (staging)
GPU_OPERATOR=skip

# --- Weka CSI (WEKA_CSI=yes; local/STORAGE.md) ---
WEKA_CSI=no
WEKA_CSI_VERSION=
WEKA_API_ENDPOINTS=weka01.example.com:14000,weka02.example.com:14000
WEKA_API_USER=csi
WEKA_API_PASSWORD_FILE=~/.secrets/weka-csi-password
WEKA_API_CA_FILE=
WEKA_ORG=Root
WEKA_SCHEME=https
WEKA_FILESYSTEM=projects
WEKA_STORAGECLASS=weka-projects
WEKA_DEFAULT_CLASS=false
WEKA_RECLAIM_POLICY=Retain

# --- CephFS CSI (CEPHFS_CSI=yes; local/STORAGE.md) ---
CEPHFS_CSI=no
CEPH_CSI_VERSION=
CEPH_CLUSTER_ID=
CEPH_MONITORS=10.0.0.1:6789,10.0.0.2:6789,10.0.0.3:6789
CEPH_FS_NAME=cephfs
CEPH_ADMIN_ID=k8s-cephfs
CEPH_ADMIN_KEY_FILE=~/.secrets/ceph-k8s-cephfs.key
CEPHFS_SUBVOLUMEGROUP=csi
CEPHFS_STORAGECLASS=cephfs-projects
CEPHFS_DEFAULT_CLASS=false
CEPHFS_RECLAIM_POLICY=Retain
# upstream (default) | remote (mirror them onto the remote first)
FEATURE_SOURCE=upstream

# Run:ai project volumes (Weka/CephFS PVC data sources per project)
PROJECT_VOLUMES=./local/storage/project-volumes.yaml

# === Warewulf overlays on the target site (make ww-overlays) ======================
WW_HOST=
WW_OVERLAYS="rke2 runai csi-storage"
# yes: write the overlays' input files on WW_HOST from the values above
WW_INSTALL_SECRETS=no
RKE2_AGENT_TOKEN_FILE=
RKE2_SERVER_URL=
WW_BUILD=no

# === scheduling ===================================================================
# What `make fetch` / `make deploy` run, in order
FETCH_STEPS="facts artifacts images features overlays verify"
DEPLOY_STEPS="preflight push prometheus gpu storage control-plane cluster catalog project-volumes verify-target"
# `make schedule` installs a crontab entry running SYNC_TARGETS at SYNC_SCHEDULE
SYNC_SCHEDULE="30 2 * * *"
SYNC_TARGETS="fetch bundle"
# bundle output and protection
BUNDLE_DIR=
BUNDLE_GPG_KEY=
BUNDLE_GPG_RECIPIENT=
