{{- /*
  Registry for every image: tag rke2_registry (host:port), default the
  Warewulf server's :5000. Tag rke2_registry_prefix: images live under
  <prefix>/ (a Harbor/Quay project); containerd rewrites the paths. Set the
  tags on a profile to point the nodes at an existing site registry
  (local/steps/30-ww-overlays.sh prints the command).
*/ -}}
{{- $reg := default (print .Ipaddr ":5000") .Tags.rke2_registry -}}
# This file is autogenerated by warewulf (overlay: rke2)
# Every upstream registry is redirected to the local mirror on the
# Warewulf server; compute nodes have no internet access.
mirrors:
  docker.io:
    endpoint:
      - "https://{{ $reg }}"
{{- with .Tags.rke2_registry_prefix }}
    rewrite:
      "^(.*)$": "{{ . }}/$1"
{{- end }}
  "*":
    endpoint:
      - "https://{{ $reg }}"
{{- with .Tags.rke2_registry_prefix }}
    rewrite:
      "^(.*)$": "{{ . }}/$1"
{{- end }}
configs:
  "{{ $reg }}":
    auth:
      username: {{ Include "/etc/rke2-registry/username" | trim }}
      password: {{ Include "/etc/rke2-registry/password" | trim }}
    tls:
      ca_file: /etc/rancher/rke2/registry-ca.crt
