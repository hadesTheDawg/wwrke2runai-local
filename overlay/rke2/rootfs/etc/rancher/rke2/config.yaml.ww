{{- /*
  RKE2 agent config, rendered per node by Warewulf.
  Nothing here is node-specific by hand: the server address is the Warewulf
  server's internal IP (tag rke2_server overrides it, e.g. an existing RKE2
  server or its VIP: https://rke2.example.com:9345), the join token is read
  from the Warewulf server at overlay build time, and the node name / IP come
  from the node's own netdev.
*/ -}}
# This file is autogenerated by warewulf (overlay: rke2)
server: {{ default (print "https://" .Ipaddr ":9345") .Tags.rke2_server }}
token: {{ Include "/etc/rancher/rke2/ww-agent-token" | trim }}
node-name: {{ .Id }}
{{- /* primary netdev if one is flagged, otherwise the first one with an IP */}}
{{- $nodeip := "" }}
{{- range $devname, $netdev := .NetDevs }}
{{- if and $netdev.Ipaddr (or $netdev.Primary (eq $nodeip "")) }}{{ $nodeip = print $netdev.Ipaddr }}{{ end }}
{{- end }}
{{- if $nodeip }}
node-ip: {{ $nodeip }}
{{- end }}
{{- if .Tags.rke2_node_labels }}
node-label:
{{- range (splitList ";" .Tags.rke2_node_labels) }}
  - {{ trim . }}
{{- end }}
{{- end }}
