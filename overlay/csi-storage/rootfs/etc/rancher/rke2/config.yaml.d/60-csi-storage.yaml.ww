{{- /*
  Keep Kubernetes off the storage client's cores and memory:
    weka_reserved_cpus   cores the Weka frontend busy-polls (e.g. "0-1"),
                         kubelet --reserved-cpus
    weka_reserved_memory system-reserved memory for the client + hugepages
                         (e.g. "6Gi")
  Rendered only when one of the tags is set; merged after config.yaml and
  50-runai.yaml ("+" appends).
*/ -}}
{{- if not (or .Tags.weka_reserved_cpus .Tags.weka_reserved_memory) }}{{ abort }}{{ end -}}
# This file is autogenerated by warewulf (overlay: csi-storage)
kubelet-arg+:
{{- with .Tags.weka_reserved_cpus }}
  - reserved-cpus={{ trim . }}
{{- end }}
{{- with .Tags.weka_reserved_memory }}
  - system-reserved=memory={{ trim . }}
{{- end }}
