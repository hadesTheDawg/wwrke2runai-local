{{- /*
  Supersedes the rke2 overlay's registries.yaml (overlays apply in order;
  runai comes after rke2). Same mirrors, plus the Run:ai workload registry
  (pull-only, :5001) as its own endpoint: without this entry the "*" mirror
  sends 10.10.172.1:5001/... pulls to the read-write registry on :5000,
  where the pull-only account Run:ai attaches to workloads does not exist
  (401 -> ImagePullBackOff).

  Tags (as in the rke2 overlay): rke2_registry, rke2_registry_prefix, and
  rke2_workload_registry (default the Warewulf server's :5001). A workload
  registry equal to rke2_registry (one site registry for both) gets no
  separate entry.
*/ -}}
{{- $reg := default (print .Ipaddr ":5000") .Tags.rke2_registry -}}
{{- $wl := default (print .Ipaddr ":5001") .Tags.rke2_workload_registry -}}
# This file is autogenerated by warewulf (overlay: runai, supersedes rke2)
mirrors:
  docker.io:
    endpoint:
      - "https://{{ $reg }}"
{{- with .Tags.rke2_registry_prefix }}
    rewrite:
      "^(.*)$": "{{ . }}/$1"
{{- end }}
{{- if ne $wl $reg }}
  "{{ $wl }}":
    endpoint:
      - "https://{{ $wl }}"
{{- end }}
  "*":
    endpoint:
      - "https://{{ $reg }}"
{{- with .Tags.rke2_registry_prefix }}
    rewrite:
      "^(.*)$": "{{ . }}/$1"
{{- end }}
configs:
  "{{ $reg }}":
    auth:
      username: {{ Include "/etc/rke2-registry/username" | trim }}
      password: {{ Include "/etc/rke2-registry/password" | trim }}
    tls:
      ca_file: /etc/rancher/rke2/registry-ca.crt
{{- if ne $wl $reg }}
  "{{ $wl }}":
    auth:
      username: {{ Include "/etc/rke2-registry/pull-username" | trim }}
      password: {{ Include "/etc/rke2-registry/pull-password" | trim }}
    tls:
      ca_file: /etc/rancher/rke2/registry-ca.crt
{{- end }}
