{{- /*
  Run:ai additions to the rke2 agent config. rke2 merges config.yaml.d/*.yaml
  after config.yaml (rke2 overlay); "node-label+" appends to its node-label.

  Tags (profile or node):
    runai_fake_gpu_pool  pool name in fake-gpu-operator's topology; the node
                         advertises simulated GPUs of that pool (GPU_MODE=fake)
    runai_node_labels    extra labels, ';'-separated (e.g. "runai/pool=a;zone=1")

  node-role.kubernetes.io/* labels cannot be set from here (kubelet refuses
  them); runai/14-expose.sh sets the Run:ai node roles from the server.
*/ -}}
# This file is autogenerated by warewulf (overlay: runai)
# All pulls go to the local registry on the Warewulf server; kubelet's
# default limit (5 QPS) makes a cold start of the Run:ai pods back off with
# "pull QPS exceeded".
kubelet-arg+:
  - registry-qps=50
  - registry-burst=100
{{- $labels := list }}
{{- if .Tags.runai_fake_gpu_pool }}
{{- $labels = append $labels (print "run.ai/simulated-gpu-node-pool=" (trim .Tags.runai_fake_gpu_pool)) }}
{{- end }}
{{- if .Tags.runai_node_labels }}
{{- range (splitList ";" .Tags.runai_node_labels) }}
{{- if trim . }}{{ $labels = append $labels (trim .) }}{{ end }}
{{- end }}
{{- end }}
{{- if $labels }}
node-label+:
{{- range $labels }}
  - {{ . }}
{{- end }}
{{- end }}
