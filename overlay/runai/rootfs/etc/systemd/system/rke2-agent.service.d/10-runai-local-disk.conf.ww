{{- /*
  Never start the agent on the tmpfs root when a local-disk file system is
  configured but not mounted: images would silently fill RAM instead.
*/ -}}
{{- $paths := list }}
{{- range $fs := .ThisNode.FileSystemList }}
{{- if and $fs.Path (ne $fs.Format "swap") }}{{ $paths = append $paths $fs.Path }}{{ end }}
{{- end }}
# This file is autogenerated by warewulf (overlay: runai)
{{- if $paths }}
[Unit]
RequiresMountsFor={{ join " " $paths }}
{{- end }}
