{{- /*
  Simulated GPUs only (tag runai_fake_gpu_pool): stand-in for the NVIDIA
  container runtime. Run:ai gives GPU-fraction pods runtimeClassName
  "nvidia"; RKE2 only creates the containerd "nvidia" handler when it finds
  this binary. Here it is plain runc, so those pods start as they would on a
  real GPU node. On real GPU nodes (no tag) this file is not written and the
  NVIDIA toolkit provides the real binary.
*/ -}}
{{- if not .Tags.runai_fake_gpu_pool }}{{ abort }}{{ end -}}
#!/bin/sh
# This file is autogenerated by warewulf (overlay: runai) - FAKE GPU NODE
exec /var/lib/rancher/rke2/bin/runc "$@"
